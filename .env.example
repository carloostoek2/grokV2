TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
REPLICATE_API_TOKEN=your_replicate_api_token_here
XAI_API_KEY=your_xai_api_key_here
KIE_API_KEY=your_kie_api_key_here            # opcional; vacío = provider no disponible

# Telegram user IDs (separados por coma) que pueden usar el bot. R9 (bot single-owner):
# pon TU ID numérico (con @userinfobot). Si lo dejas vacío el bot queda abierto a CUALQUIER
# usuario que te escriba en privado (SOLO chat privado) y el boot te lo avisa.
ALLOWED_TELEGRAM_IDS=123456789
# Admins del panel /listas. Vacío = todos los permitidos (o todos si no hay allowlist).
VARIABLES_ADMIN_IDS=

# Tiempo (seg) de espera de confirmación de refine ComfyUI.
REFINE_CONFIRM_TIMEOUT=300

# ComfyUI (Colab actual): el bot llega a la VM por SSH (alias de ~/.ssh/config) y habla
# con la API nativa (REST+WS) por un túnel local-forward.
# COMFYUI_HOST/COMFYUI_PORT = endpoint SSH (host vacío = deshabilitado).
# En Colab: COMFYUI_HOST=colab-comfy (alias SSH) y COMFYUI_PORT=22.
COMFYUI_HOST=
COMFYUI_PORT=22
# Puerto HTTP de ComfyUI DENTRO de la VM (el túnel forwardea a 127.0.0.1:<este>)
# y puerto LOCAL a bindear (0 = elegir uno efímero libre).
# Colab actual: 8188 (loopback). Vast histórico: 18188.
COMFYUI_REMOTE_PORT=8188
COMFYUI_TUNNEL_LOCAL_PORT=0
# Origen de los grafos API-format: embed (templates/ del repo) | remote (SSH-cat en el box).
# Colab actual: embed = fuente de verdad en workflows/templates/{flow_id}.json.
# remote histórico Vast: /workspace/ComfyUI/user/default/api_workflows/{flow_id}.json
# (fallback a embed si falta). Actualizar un flujo en remote: Export API en la UI y
# sobrescribir ese JSON en el box; no hay conversor UI→API en el bot.
COMFYUI_WORKFLOW_SOURCE=embed
COMFYUI_WORKFLOWS_DIR=/content/drive/MyDrive/ComfyUI/user/default/api_workflows
COMFYUI_WORKFLOW_CACHE_TTL=45


# Directorio de datos de repos (sessions.json, variables_lists.json, generation_refs.json, variables_packages/).
GROK_DATA_DIR=data
