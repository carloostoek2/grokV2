{
  "_meta": {
    "id": "face_detail_impact",
    "name": "Face Detail",
    "media_type": "image",
    "positive_node": "5",
    "positive_input": "text",
    "negative_node": "6",
    "seed_nodes": [
      "9"
    ],
    "save_nodes": [
      "10"
    ],
    "supports_source": true,
    "requires_source": true,
    "source_node": "1",
    "source_input": "image",
    "timeout": 600,
    "notes": "Second-stage face inpaint. Any PNG (Krea/Flux/upload) via LoadImage. Detail pass is SDXL sd_xl_base_1.0, not the original T2I backbone. Chain: LoadImage -> 4x-UltraSharp -> FaceDetailer (YOLO face_yolov8m + SAM vit_b) -> SaveImage."
  },
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "example.png"
    }
  },
  "2": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "4x-UltraSharp.pth"
    }
  },
  "3": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {
      "upscale_model": [
        "2",
        0
      ],
      "image": [
        "1",
        0
      ]
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "detailed face, sharp eyes, natural skin texture, high detail",
      "clip": [
        "4",
        1
      ]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, deformed, extra eyes, asymmetric eyes, plastic skin, watermark, low quality",
      "clip": [
        "4",
        1
      ]
    }
  },
  "7": {
    "class_type": "UltralyticsDetectorProvider",
    "inputs": {
      "model_name": "bbox/face_yolov8m.pt"
    }
  },
  "8": {
    "class_type": "SAMLoader",
    "inputs": {
      "model_name": "sam_vit_b_01ec64.pth",
      "device_mode": "AUTO"
    }
  },
  "9": {
    "class_type": "FaceDetailer",
    "inputs": {
      "image": [
        "3",
        0
      ],
      "model": [
        "4",
        0
      ],
      "clip": [
        "4",
        1
      ],
      "vae": [
        "4",
        2
      ],
      "guide_size": 768,
      "guide_size_for": true,
      "max_size": 1280,
      "seed": 0,
      "steps": 20,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": [
        "5",
        0
      ],
      "negative": [
        "6",
        0
      ],
      "denoise": 0.4,
      "feather": 5,
      "noise_mask": true,
      "force_inpaint": true,
      "bbox_threshold": 0.5,
      "bbox_dilation": 10,
      "bbox_crop_factor": 3.0,
      "sam_detection_hint": "center-1",
      "sam_dilation": 0,
      "sam_threshold": 0.93,
      "sam_bbox_expansion": 0,
      "sam_mask_hint_threshold": 0.7,
      "sam_mask_hint_use_negative": "False",
      "drop_size": 10,
      "bbox_detector": [
        "7",
        0
      ],
      "wildcard": "",
      "cycle": 1,
      "sam_model_opt": [
        "8",
        0
      ],
      "inpaint_model": false,
      "noise_mask_feather": 20
    }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "9",
        0
      ],
      "filename_prefix": "face_detail_impact"
    }
  }
}
